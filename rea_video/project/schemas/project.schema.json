{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FlapPearLabs/rea-video/schemas/project.schema.json",
  "title": "rea-video structured project state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "title", "profile", "state",
    "coordinator", "paid_generation", "created_at", "updated_at",
    "inputs", "artifacts", "tasks", "handoffs",
    "current_handoff", "current_handoff_md"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "profile": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "state": {"enum": ["initialized", "input_validated", "decomposed", "reviewed", "planned", "remaking", "assembled", "verified", "delivered", "blocked"]},
    "coordinator": {"type": "string", "minLength": 1},
    "paid_generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "approved_by", "approved_at", "scope", "confirmation"],
      "properties": {
        "approved": {"type": "boolean"},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"type": ["string", "null"]},
        "scope": {"type": ["string", "null"]},
        "confirmation": {"type": ["string", "null"]}
      }
    },
    "blocked_from": {"type": ["string", "null"]},
    "blocked_reason": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "brief"],
      "properties": {
        "manifest": {"const": "input/input.json"},
        "brief": {"const": "input/brief.md"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "kind", "stage"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "kind": {"enum": ["analysis", "media", "plan", "handoff", "output", "other"]},
          "stage": {"type": "string", "minLength": 1}
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "handoffs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "current_handoff": {"type": ["string", "null"]},
    "current_handoff_md": {"const": "HANDOFF.md"},
    "artifact_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "sequence", "artifact_id", "path_before", "path_after",
                     "sha256_before", "sha256_after", "created_at", "coordinator", "by", "reason"],
        "properties": {
          "schema_version": {"const": "1.0.0"},
          "sequence": {"type": "integer", "minimum": 1},
          "artifact_id": {"type": "string", "minLength": 1},
          "path_before": {"type": "string", "minLength": 1},
          "path_after": {"type": "string", "minLength": 1},
          "sha256_before": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "sha256_after": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "created_at": {"type": "string", "minLength": 1},
          "coordinator": {"type": "string", "minLength": 1},
          "by": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "blocked"}}, "required": ["state"]},
      "then": {
        "properties": {
          "blocked_from": {
            "enum": ["initialized", "input_validated", "decomposed", "reviewed", "planned",
                     "remaking", "assembled", "verified", "delivered"]
          }
        },
        "required": ["blocked_from"]
      }
    }
  ]
}
