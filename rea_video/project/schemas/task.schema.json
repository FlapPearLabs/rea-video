{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FlapPearLabs/rea-video/schemas/task.schema.json",
  "title": "rea-video structured project task ownership",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_id", "title", "stage", "state", "owner",
    "write_paths", "inputs", "acceptance", "outputs", "summary",
    "created_at", "updated_at", "lease_expires_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,48}$"},
    "title": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "state": {"enum": ["pending", "in_progress", "completed", "blocked", "stale"]},
    "owner": {"type": ["string", "null"]},
    "write_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "acceptance": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": ["string", "null"]},
    "reason": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "lease_expires_at": {"type": ["string", "null"]}
  }
}
